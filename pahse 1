  // res (ServerResponse)  = what you send back

  // ── Reading the request ────────────────────────────
  console.log(req.method);  // 'GET' | 'POST' | 'PUT' | 'DELETE'
  console.log(req.url);     // '/users?page=2' (path + query string)
  console.log(req.headers); // { 'content-type': 'application/json', ... }

  // Parse URL safely:
  const url    = new URL(req.url, \`http://\${req.headers.host}\`);
  const path   = url.pathname;       // '/users' (without query)
  const page   = url.searchParams.get('page'); // '2'

  // Read POST/PUT body (comes as a stream):
  const body = await new Promise((resolve) => {
    let raw = '';
    req.on('data', chunk => { raw += chunk.toString(); });
    req.on('end',  ()    => { resolve(raw ? JSON.parse(raw) : null); });
  });

  // ── Sending the response ───────────────────────────
  // Helper function (you'd normally put this in a utility file):
  const json = (data, status = 200) => {
    res.writeHead(status, {
      'Content-Type':                'application/json',
      'Access-Control-Allow-Origin': '*', // CORS
    });
    res.end(JSON.stringify(data));
  };

  // ── Routing ────────────────────────────────────────
  if (req.method === 'GET' && path === '/') {
    return json({ message: 'Hello from Node.js!', status: 'ok' });
  }

  if (req.method === 'GET' && path === '/health') {
    return json({ ok: true, uptime: process.uptime() });
  }

  if (req.method === 'GET' && path === '/users') {
    const users = [{ id: 1, name: 'Alice' }, { id: 2, name: 'Bob' }];
    return json(users);
  }

  if (req.method === 'POST' && path === '/users') {
    if (!body?.name) return json({ error: 'name is required' }, 400);
    const newUser = { id: Date.now(), ...body };
    return json({ created: true, user: newUser }, 201);
  }

  json({ error: \`Route \${req.method} \${path} not found\` }, 404);
});

// Start listening on port 3000:
server.listen(3000, () => {
  console.log('🚀 Server running at http://localhost:3000');
});

// Handle startup errors:
server.on('error', (err) => {
  if (err.code === 'EADDRINUSE') {
    console.error('❌ Port 3000 is already in use!');
    process.exit(1);
  }
});`} />
        <Tip icon="💡" color={T.cyan} title="Use Express or Fastify in real projects">
