      <ModuleCard name="child_process" color={T.yellow} icon="🔀" tagline="Run shell commands, scripts, and other programs from Node.js">
        <EasyBox emoji="🔀" title="What is child_process?" color={T.yellow}>
          Sometimes you need your Node.js program to run other programs — shell commands, Python scripts, C executables, Git commands, FFmpeg for video, ImageMagick for images. The <code style={{ color: T.yellow, fontFamily: mono }}>child_process</code> module lets you spawn these processes and communicate with them. Think of it as giving Node.js a terminal to type into.
        </EasyBox>
        <CodeBlock label="exec — run a command, get the output" code={`import { exec, execSync } from 'child_process';
import { promisify } from 'util';

// EXEC with callback style:
exec('git log --oneline -5', (err, stdout, stderr) => {
  if (err) { console.error('Failed:', err.message); return; }
  if (stderr) console.warn('Warning:', stderr);
  console.log(stdout); // the output
});

// EXEC with async/await (promisify makes it promise-based):
const execAsync = promisify(exec);

const { stdout, stderr } = await execAsync('git log --oneline -5');
console.log(stdout);

// Real usage examples:
await execAsync('npm run build');
await execAsync('pg_dump mydb > backup.sql');
const { stdout: branch } = await execAsync('git branch --show-current');

// ⚠️ exec() BUFFERS all output in memory.
// Default limit is 1MB. Large output → crash.
// For large output, use spawn() instead.

// EXECSYNC — synchronous, blocks event loop:
const version = execSync('node --version').toString().trim();
// Only use in CLI tools / startup scripts — NEVER in HTTP servers!`} />
        <CodeBlock label="spawn — streaming output, large commands" code={`import { spawn } from 'child_process';

// SPAWN streams stdout/stderr chunk by chunk:
const buildProcess = spawn('npm', ['run', 'build']);

buildProcess.stdout.on('data', (chunk) => {
  process.stdout.write(chunk); // stream build output in real time
});

buildProcess.stderr.on('data', (chunk) => {
  process.stderr.write(chunk);
});

buildProcess.on('close', (exitCode) => {
  if (exitCode === 0) console.log('Build succeeded!');
  else console.error(\`Build failed with code \${exitCode}\`);
});

// Use spawn for:
// - Large output (logs, exports, find results)
// - Long-running processes (dev servers, watchers)
// - Binary output (images, audio)
// - Real-time streaming (progress bars)`} />
        <CodeBlock label="fork — run another Node.js file (own process + memory)" code={`import { fork } from 'child_process';

// FORK creates a separate Node.js process with IPC channel:
// Perfect for: CPU-heavy tasks that would block the event loop

const worker = fork('./workers/image-resizer.js');

// Send data to the worker:
worker.send({ file: './photos/original.jpg', width: 800, quality: 85 });

// Receive results:
worker.on('message', (result) => {
  console.log('Resized image saved to:', result.outputPath);
  worker.kill(); // clean up when done
});

worker.on('error',  err  => console.error('Worker error:', err));
worker.on('exit',   code => console.log('Worker exited:', code));

// ── In ./workers/image-resizer.js ────────────────────────
process.on('message', async ({ file, width, quality }) => {
  const outputPath = await resizeImage(file, width, quality);
  process.send({ outputPath, success: true });
});`} />
