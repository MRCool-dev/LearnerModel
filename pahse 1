              <div style={{ fontSize: 10, color: T.red, fontFamily: mono, marginBottom: 4 }}>❌ PROBLEM</div>
              <div style={{ fontSize: 11, color: T.muted, fontFamily: serif, lineHeight: 1.7 }}>{problem}</div>
            </div>
