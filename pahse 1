function SectionModules() {
  const [tab, setTab] = useState("what");
  const tabs = [{ id: "what", label: "🤔 What & Why" }, { id: "cjs", label: "📦 CommonJS" }, { id: "esm", label: "🔷 ES Modules" }, { id: "wrapper", label: "🎁 Module Wrapper" }, { id: "compare", label: "⚖️ Compare" }];
  return (
    <div>
      <p style={para}>Every file in Node.js is a module. Understanding modules is essential because <em>every single line of Node.js code you write</em> lives inside a module.</p>

      <div style={{ display: "flex", gap: 5, flexWrap: "wrap", marginBottom: 14 }}>
        {tabs.map(t => <button key={t.id} onClick={() => setTab(t.id)} style={{ padding: "5px 12px", fontSize: 11, fontFamily: mono, background: tab === t.id ? T.orange + "22" : "transparent", border: `1px solid ${tab === t.id ? T.orange : T.border}`, color: tab === t.id ? T.orange : T.muted, borderRadius: 5, cursor: "pointer" }}>{t.label}</button>)}
      </div>

      {tab === "what" && (
        <div>
          <BigIdea number="1" title="What is a module?" color={T.orange}>
            A module is just a file. But a special kind of file: its variables and functions are <em>private by default</em>. Nothing leaks out to other files. If you create a variable called <code style={{ color: T.orange, fontFamily: mono }}>const name = 'Alice'</code> in one file, no other file can see it — unless you explicitly choose to export it. This is the opposite of browser JS where everything you put on <code>window</code> is global.
          </BigIdea>
          <EasyBox emoji="🔒" title="Why private by default?" color={T.blue}>
            Imagine you're building a large app with 50 files. Without modules, if any file creates a variable named <code style={{ color: T.blue, fontFamily: mono }}>user</code>, it could accidentally overwrite another file's <code>user</code> variable. Chaos. Modules prevent this — each file has its own private scope. You only share what you intentionally export.
          </EasyBox>
          <CodeBlock label="without modules — global scope chaos" code={`// file1.js
var user = 'Alice';  // global!

// file2.js (loaded after file1)
var user = 'Bob';    // overwrites Alice's user!

// file3.js
console.log(user);   // 'Bob' — but you expected 'Alice'
// This is the nightmare modules solve.`} />
          <CodeBlock label="with modules — private by default" code={`// file1.js (a module)
const user = 'Alice';  // private to this file
// → file2 cannot see this 'user' at all

// file2.js (a module)
const user = 'Bob';    // completely separate variable
// → no conflict with file1's user

// To share, you must explicitly export:
// file1.js
export const user = 'Alice';  // intentionally shared

// file2.js
import { user } from './file1.js';
console.log(user); // 'Alice' — controlled access`} />
        </div>
      )}

      {tab === "cjs" && (
        <div>
          <EasyBox emoji="📦" title="CommonJS — the original Node module system" color={T.orange}>
            CommonJS (CJS) was created specifically for Node.js in 2009. It uses <code style={{ color: T.orange, fontFamily: mono }}>require()</code> to import and <code style={{ color: T.orange, fontFamily: mono }}>module.exports</code> to export. It loads modules <strong>synchronously</strong> — when you call require(), Node reads and executes that file right now, blocking until done. That's fine on a server where files are local (microseconds), but would be terrible in a browser (milliseconds over network).
          </EasyBox>
          <CodeBlock label="exporting from a module — three patterns" code={`// ── math.js ──────────────────────────────────

// PATTERN 1: Export an object with multiple things (most common)
module.exports = {
  add:      (a, b) => a + b,
  subtract: (a, b) => a - b,
  multiply: (a, b) => a * b,
  PI:       3.14159,
};

// PATTERN 2: Export a single thing (a class, function, or value)
module.exports = function add(a, b) { return a + b; };
// or
module.exports = class Database { ... };

// PATTERN 3: Add exports one at a time
exports.add      = (a, b) => a + b;
exports.subtract = (a, b) => a - b;

// ⚠️ THE TRAP — never do this:
exports = { add, subtract };
// This BREAKS because exports is a reference to module.exports.
// Reassigning exports creates a NEW object, disconnecting
// it from module.exports. require() returns the old empty object.
// Always use module.exports = {...} when replacing entirely.`} />
