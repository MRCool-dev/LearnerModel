        <EasyBox emoji="📡" title="What is EventEmitter?" color={T.orange}>
          The EventEmitter is the pattern that Node.js is built on. HTTP servers, file streams, database connections, network sockets — they all use EventEmitter under the hood.<br /><br />
          Think of it like a radio station (the emitter) and radios (the listeners). The station broadcasts events. Anyone tuned in receives them. The station doesn't know or care who is listening — it just broadcasts. This is called <strong>pub/sub</strong> (publish/subscribe) or the <strong>observer pattern</strong>.
        </EasyBox>
        <CodeBlock label="eventemitter — everything you need to know" code={`import { EventEmitter } from 'events';

// Create your own emitter by extending EventEmitter:
class OrderSystem extends EventEmitter {
  placeOrder(item, price) {
    console.log(\`Order placed: \${item}\`);

    // EMIT — broadcast an event with data attached:
    this.emit('order', { item, price, time: new Date() });

    // You can emit multiple different events:
    if (price > 100) {
      this.emit('bigOrder', item);
    }
  }
}

const shop = new OrderSystem();

// .on() — SUBSCRIBE — runs every time event is emitted:
shop.on('order', (orderData) => {
  console.log(\`📦 Shipping: \${orderData.item} for $\${orderData.price}\`);
});

shop.on('order', (orderData) => {
  // Multiple listeners for the same event — both run!
  console.log(\`💾 Saved to DB: \${orderData.item}\`);
});

// .once() — runs only the FIRST time, then auto-removes itself:
shop.once('bigOrder', (item) => {
  console.log(\`🎉 First big order: \${item}! Notify the team!\`);
});

// Place some orders:
shop.placeOrder('Book', 15);    // triggers 'order' only
shop.placeOrder('Laptop', 999); // triggers 'order' AND 'bigOrder'
shop.placeOrder('TV', 500);     // triggers 'order' + 'bigOrder' again,
                                 // but once() already fired → silent

// REMOVE a specific listener:
const inventoryHandler = (data) => updateInventory(data);
shop.on('order', inventoryHandler);
// Later, when you want to stop listening:
shop.off('order', inventoryHandler);    // same as removeListener

// INSPECT the emitter:
shop.eventNames();              // ['order', 'bigOrder']
shop.listenerCount('order');   // 2

// ❗ CRITICAL: ALWAYS handle 'error' events:
// If an 'error' event is emitted with no listener,
// Node.js CRASHES the entire process immediately!
shop.on('error', (err) => {
  console.error('Shop system error:', err.message);
  // Handle gracefully — log it, send alert, don't crash
});

// Trigger an error:
shop.emit('error', new Error('Payment service down'));
// ✅ Caught — process continues running`} />
