function CodeBlock({ label, code }) {
  const [copied, setCopied] = useState(false);
  return (
    <div style={{ margin: "10px 0" }}>
      <div style={{ display: "flex", justifyContent: "space-between", marginBottom: 3 }}>
        <span style={{ fontSize: 10, color: "#1e2840", letterSpacing: 2, textTransform: "uppercase", fontFamily: mono }}>{label}</span>
        <button onClick={() => { navigator.clipboard.writeText(code); setCopied(true); setTimeout(() => setCopied(false), 1800); }}
          style={{ background: "transparent", border: `1px solid ${copied ? T.green : "#1a2235"}`, color: copied ? T.green : "#2a3550", borderRadius: 3, padding: "2px 9px", fontSize: 10, cursor: "pointer", fontFamily: mono }}>
          {copied ? "✓ copied" : "copy"}
        </button>
      </div>
      <pre style={{ margin: 0, padding: "12px 14px", background: "#03050c", border: "1px solid #0e1420", borderRadius: 7, fontSize: 11, lineHeight: 1.9, overflowX: "auto", color: "#a8b8d8", fontFamily: mono, whiteSpace: "pre-wrap", wordBreak: "break-word" }}>
        <code>{code}</code>
      </pre>
    </div>
  );
}

function Tip({ icon = "💡", color = T.yellow, title, children }) {
  return (
    <div style={{ margin: "10px 0", padding: "10px 14px", background: color + "10", border: `1px solid ${color}40`, borderLeft: `4px solid ${color}`, borderRadius: "0 7px 7px 0" }}>
      <div style={{ fontSize: 11, fontWeight: 700, color, marginBottom: 3, fontFamily: mono }}>{icon} {title}</div>
      <div style={{ fontSize: 12, color: T.muted, lineHeight: 1.75, fontFamily: serif }}>{children}</div>
    </div>
  );
}

function EasyBox({ emoji, title, color, children }) {
