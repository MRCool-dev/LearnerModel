const axios   = require('axios');
const lodash  = require('lodash');

// Dynamic require (choose which module at runtime):
const db = process.env.DATABASE_TYPE === 'postgres'
  ? require('./db/postgres')
  : require('./db/mysql');

// require() CACHES results:
// Second call to require('./math') returns the SAME object
// The file is NOT re-executed. This is usually what you want.
console.log(require.cache); // see everything that's been cached`} />
