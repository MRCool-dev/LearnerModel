// Destructure on import (clean and common):
const { add, subtract, PI } = require('./math');
console.log(add(10, 5));         // 15

// Import a Node CORE module (no path, no npm install):
const fs   = require('fs');
const path = require('path');
const http = require('http');
const os   = require('os');

