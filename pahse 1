function SectionEventLoop() {
  const [tab, setTab] = useState("problem");
  const tabs = [
    { id: "problem", label: "😩 The Problem" },
    { id: "solution", label: "💡 The Solution" },
    { id: "phases", label: "🔄 Loop Phases" },
    { id: "order", label: "📊 Execution Order" },
    { id: "demo", label: "🧪 Live Demo" },
    { id: "quiz", label: "🧠 Quiz" },
  ];
  return (
    <div>
      <p style={para}>The Event Loop is the single most important concept in Node.js. If you understand this deeply, everything else makes sense. If you don't, Node.js will confuse you constantly.</p>

      <div style={{ display: "flex", gap: 5, flexWrap: "wrap", marginBottom: 14 }}>
        {tabs.map(t => <button key={t.id} onClick={() => setTab(t.id)} style={{ padding: "5px 12px", fontSize: 11, fontFamily: mono, background: tab === t.id ? T.orange + "22" : "transparent", border: `1px solid ${tab === t.id ? T.orange : T.border}`, color: tab === t.id ? T.orange : T.muted, borderRadius: 5, cursor: "pointer" }}>{t.label}</button>)}
      </div>

      {tab === "problem" && (
        <div>
          <BigIdea number="1" title="Traditional servers: one thread per request" color={T.red}>
            Imagine a restaurant where every customer gets their own dedicated waiter who stands with them the entire meal and does nothing else. The waiter is "blocked" — waiting while you look at the menu, waiting while your food is cooked, waiting while you eat. If 1,000 customers arrive, you need 1,000 waiters. Each waiter (thread) costs about 1MB of RAM. 1,000 threads = 1GB RAM just for waiting. When a burst of traffic hits, you run out of waiters and new customers queue up outside.
          </BigIdea>
          <BigIdea number="2" title="The problem with threads for I/O" color={T.orange}>
            In a web server, most of the time is spent doing I/O — waiting for a database to respond, waiting for a file to be read, waiting for a network request to return. The actual CPU work (running JavaScript, forming a response) takes microseconds. But the thread is blocked the entire time, doing nothing, consuming resources. This is catastrophically wasteful.
          </BigIdea>
          <CodeBlock label="the traditional blocking model" code={`// What a traditional threaded server does:

// Request 1 arrives → create Thread 1
Thread 1: SELECT * FROM users WHERE id = 1;
Thread 1: waiting... waiting... waiting... (50ms doing nothing)
Thread 1: got result → send response → thread freed

// Meanwhile, Request 2 arrives → create Thread 2
// Request 3 arrives → create Thread 3
// ... Request 10,000 arrives → create Thread 10,000
// System runs out of memory. New requests time out. Server dies.

// Each thread costs: ~1MB RAM + context switching overhead
// 10,000 concurrent users = 10GB RAM just for threads`} />
        </div>
      )}

      {tab === "solution" && (
        <div>
          <BigIdea number="1" title="Node's answer: one smart waiter" color={T.green}>
            Now imagine a different kind of restaurant. There's ONE extremely efficient waiter. When a customer orders, the waiter writes it down, gives the order to the kitchen, and immediately walks to the next customer. The waiter never waits. When the kitchen has food ready, they call out and the waiter delivers it between taking new orders. One waiter serves hundreds of customers because they never block — they're always doing something.
          </BigIdea>
          <BigIdea number="2" title="How Node.js does this" color={T.blue}>
            Node.js has one JavaScript thread (the "waiter"). When you call fs.readFile(), Node writes down your callback, hands the actual file read to the OS (the "kitchen"), and immediately runs the next line of code. When the OS finishes reading, it notifies Node, which puts your callback in a queue. The Event Loop sees the callback in the queue, picks it up, and runs it. No blocking. No waiting.
          </BigIdea>
          <EasyBox emoji="🔄" title="The Event Loop in plain English" color={T.orange}>
            The Event Loop is just a loop that keeps asking: <br /><br />
            <strong>"Is the Call Stack empty?"</strong> → If yes: <strong>"Is there anything in the Microtask Queue?"</strong> → If yes: run it. → <strong>"Any setTimeout/setInterval callbacks ready?"</strong> → If yes: run one. → <strong>"Any setImmediate callbacks?"</strong> → repeat forever.<br /><br />
            That's it. The "loop" is just checking queues in a specific order, over and over, as long as Node is running.
          </EasyBox>
          <CodeBlock label="non-blocking node.js — one thread, many connections" code={`// Node.js with 10,000 concurrent connections:

// All 10,000 requests are started:
for (const req of 10000Requests) {
  db.query('SELECT * FROM users', (result) => {
    req.send(result); // callback fires when DB responds
  });
  // Node doesn't wait — immediately starts next request
}

// While 10,000 DB queries run in parallel (OS level):
// Node's ONE thread is free to handle new requests
// Memory used: ~kilobytes per connection (not 1MB per thread!)

// When DB queries finish (one by one):
// Callbacks queue up in the Event Loop
// Node processes them one at a time as they arrive`} />
        </div>
      )}

      {tab === "phases" && (
        <div>
          <p style={para}>The Event Loop has specific phases it cycles through in order. Each phase has its own queue of callbacks to process.</p>
          <div style={{ display: "flex", flexDirection: "column", gap: 8, marginBottom: 14 }}>
            {[
              { phase: "timers", color: T.orange, icon: "⏰", desc: "Runs callbacks from setTimeout() and setInterval() whose time has expired. Note: the timer only guarantees a MINIMUM delay, not an exact one.", example: "setTimeout(fn, 100) → runs here, after ≥100ms" },
              { phase: "pending I/O", color: T.blue, icon: "📥", desc: "I/O callbacks that were deferred from the previous loop iteration. Rarely something you interact with directly.", example: "Internal: certain system errors" },
              { phase: "idle / prepare", color: T.muted, icon: "💤", desc: "Internal use only. Node uses this internally between phases. You will never directly interact with this phase.", example: "Internal Node.js mechanics only" },
              { phase: "poll", color: T.green, icon: "🔍", desc: "The most important phase. Retrieves new I/O events (file reads, network responses). Executes their callbacks. If queue is empty and no timers, Node WAITS here for new I/O events — this is where Node spends most of its time.", example: "fs.readFile callback runs here, HTTP responses run here" },
              { phase: "check", color: T.purple, icon: "✓", desc: "Runs setImmediate() callbacks. Always runs after the poll phase completes, even if poll was empty.", example: "setImmediate(fn) → runs here" },
              { phase: "close events", color: T.red, icon: "🔒", desc: "Close event callbacks — when a socket or file handle is abruptly closed.", example: "socket.on('close', ...) runs here" },
              { phase: "⚡ microtasks (between every phase)", color: T.cyan, icon: "⚡", desc: "Microtasks are NOT a phase — they run BETWEEN every phase, draining completely before the next phase starts. process.nextTick() runs first (even before Promises), then Promise .then/.catch callbacks.", example: "Highest priority — always beats setTimeout and setImmediate" },
            ].map((item, i) => (
              <div key={i} style={{ display: "flex", gap: 12, padding: "10px 13px", background: item.color + "08", border: `1px solid ${item.color}22`, borderRadius: 8 }}>
                <span style={{ fontSize: 18, flexShrink: 0 }}>{item.icon}</span>
                <div style={{ flex: 1 }}>
                  <div style={{ fontSize: 12, fontWeight: 700, color: item.color, fontFamily: mono, marginBottom: 4 }}>{item.phase}</div>
                  <div style={{ fontSize: 12, color: T.muted, fontFamily: serif, lineHeight: 1.7, marginBottom: 4 }}>{item.desc}</div>
                  <div style={{ fontSize: 10, color: item.color + "99", fontFamily: mono }}>→ {item.example}</div>
                </div>
              </div>
            ))}
          </div>
        </div>
      )}

      {tab === "order" && (
        <div>
          <p style={para}>This is the most commonly asked Node.js interview question. You need to know the exact execution order cold.</p>
          <div style={{ marginBottom: 14 }}>
            <div style={{ fontSize: 11, fontWeight: 700, color: T.text, fontFamily: mono, marginBottom: 10 }}>The order — memorise this:</div>
            {[
              { order: "1st", label: "Synchronous code", color: T.blue, detail: "Everything on the call stack right now. const x = 5; function calls; loops. Always runs first, no exceptions." },
              { order: "2nd", label: "process.nextTick()", color: T.cyan, detail: "Highest priority async callback. Runs before even Promises. Rarely used directly — mostly for library authors. Tip: if you nextTick() inside a nextTick(), the new one runs before any Promises too." },
              { order: "3rd", label: "Promise .then / .catch", color: T.purple, detail: "Microtasks. ALL microtasks drain completely — if a .then() creates another .then(), that also runs before any setTimeout. Only stops when the microtask queue is empty." },
              { order: "4th", label: "setTimeout() / setInterval()", color: T.orange, detail: "Macrotasks. Timer phase of the Event Loop. Even setTimeout(fn, 0) has to wait for all sync code and all microtasks first. '0ms' means 'as soon as all microtasks are done'." },
              { order: "5th", label: "setImmediate()", color: T.yellow, detail: "Runs in the 'check' phase, after the poll phase. In practice very similar to setTimeout(fn, 0) but setImmediate always runs before setTimeout in I/O callback context." },
              { order: "6th", label: "I/O callbacks (fs, network)", color: T.green, detail: "File read callbacks, HTTP response callbacks — run in the poll phase. After these run, any microtasks they created run before the next I/O callback." },
            ].map((item, i) => (
              <div key={i} style={{ display: "flex", gap: 12, marginBottom: 6, alignItems: "flex-start" }}>
                <div style={{ width: 36, height: 36, borderRadius: "50%", background: item.color + "22", border: `1px solid ${item.color}55`, display: "flex", alignItems: "center", justifyContent: "center", fontSize: 10, fontWeight: 700, color: item.color, fontFamily: mono, flexShrink: 0 }}>{item.order}</div>
                <div style={{ flex: 1, padding: "7px 11px", background: item.color + "08", border: `1px solid ${item.color}22`, borderRadius: 7 }}>
                  <div style={{ fontSize: 12, fontWeight: 700, color: item.color, fontFamily: mono, marginBottom: 3 }}>{item.label}</div>
                  <div style={{ fontSize: 12, color: T.muted, fontFamily: serif, lineHeight: 1.7 }}>{item.detail}</div>
                </div>
              </div>
            ))}
          </div>
          <CodeBlock label="the classic interview question — predict the output" code={`console.log('A');                          // sync

setTimeout(() => console.log('E'), 0);    // macrotask (timer)

Promise.resolve()
  .then(() => console.log('C'))           // microtask
  .then(() => console.log('D'));          // microtask (chained)

process.nextTick(() => console.log('B')); // microtask (nextTick first)

console.log('A2');                        // sync

// Output: A → A2 → B → C → D → E
//
// Why?
// A, A2 → sync code runs first, in order
// B      → process.nextTick fires before Promises
// C      → first Promise .then
// D      → second .then (microtask created by previous microtask)
// E      → setTimeout fires last (macrotask)`} />
        </div>
      )}

      {tab === "demo" && <EventLoopDemo />}

      {tab === "quiz" && (
        <div>
          <QuizCard
            question="What is the Event Loop?"
            options={["A for loop that processes requests", "A mechanism that checks queues and runs callbacks when the call stack is empty", "The V8 engine's JavaScript compiler", "A thread pool for handling I/O"]}
            correct={1}
            explain="The Event Loop is a continuous loop that checks the Call Stack and various callback queues, running callbacks in order of priority when the stack is empty."
          />
          <QuizCard
            question="Which runs FIRST after synchronous code finishes?"
            options={["setTimeout callback", "setImmediate callback", "process.nextTick callback", "I/O callback"]}
            correct={2}
            explain="process.nextTick has the highest priority of any async callback — it runs before even Promise .then callbacks. Then Promises, then macrotasks (setTimeout/setImmediate)."
          />
          <QuizCard
            question="setTimeout(fn, 0) means the function runs..."
            options={["Immediately, in the current tick", "After 0 milliseconds exactly", "After all sync code AND all microtasks finish", "Before Promise callbacks"]}
            correct={2}
            explain="Even with 0ms delay, setTimeout must wait for all synchronous code to finish AND for all microtasks (Promises, nextTick) to drain completely. The '0' is a minimum delay, not an exact one."
          />
          <QuizCard
            question="Why can Node.js handle 10,000 connections on a single thread?"
            options={["It creates threads automatically", "It runs JS faster than other languages", "I/O operations are handed to the OS — the single thread never blocks waiting", "It uses multiple CPU cores"]}
            correct={2}
            explain="Non-blocking I/O: Node hands file reads, network calls, etc. to the OS, then immediately continues. The single thread is always busy doing JS work, never waiting for I/O. Callbacks fire when the OS finishes — no blocking, no wasted CPU cycles."
          />
        </div>
      )}
    </div>
  );
}

