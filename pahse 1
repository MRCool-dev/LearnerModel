function EventLoopDemo() {
  const [step, setStep] = useState(-1);
  const [running, setRunning] = useState(false);
  const [output, setOutput] = useState([]);

  const steps = [
    { label: "console.log('1 — sync') executes", phase: "sync", color: T.blue, out: "1 — sync", desc: "Synchronous code always runs first. It goes straight onto the Call Stack and executes immediately." },
    { label: "setTimeout(fn, 0) is registered", phase: "sync", color: T.blue, out: null, desc: "Node hands the timer to the OS. It says 'run this callback after 0ms'. Node does NOT wait — it moves on immediately." },
    { label: "Promise.resolve().then(fn) queued", phase: "sync", color: T.blue, out: null, desc: "The Promise callback is added to the Microtask Queue — a high-priority queue that runs before any timers." },
    { label: "console.log('2 — sync') executes", phase: "sync", color: T.blue, out: "2 — sync", desc: "Still synchronous. All sync code on the Call Stack finishes before ANY async callback can run." },
    { label: "▶ Call Stack empty — check Microtask Queue", phase: "micro", color: T.purple, out: null, desc: "The Call Stack is now empty. The Event Loop checks: are there any Microtasks (Promises, nextTick)? Yes!" },
    { label: "Promise .then callback fires", phase: "micro", color: T.purple, out: "3 — promise", desc: "ALL microtasks drain completely. Promises always beat setTimeout. This is critical to understand." },
    { label: "▶ Microtasks empty — check Timer Queue", phase: "macro", color: T.orange, out: null, desc: "No more microtasks. The Event Loop moves to the Timer phase — checking for expired setTimeouts." },
    { label: "setTimeout callback finally fires", phase: "macro", color: T.orange, out: "4 — timeout", desc: "Only now does the setTimeout run. Even though we said 0ms, it had to wait for all sync code AND all microtasks first." },
  ];

  const run = async () => {
    setRunning(true); setStep(-1); setOutput([]);
    for (let i = 0; i < steps.length; i++) {
      await new Promise(r => setTimeout(r, 800));
      setStep(i);
      if (steps[i].out) setOutput(p => [...p, { text: steps[i].out, color: steps[i].color }]);
    }
    setRunning(false);
  };

  return (
    <div style={{ padding: 14, background: T.surface, border: `1px solid ${T.border}`, borderRadius: 10 }}>
      <div style={{ fontSize: 10, color: T.muted, fontFamily: mono, letterSpacing: 1, marginBottom: 10 }}>🧪 LIVE — watch exactly what runs and when</div>
      <div style={{ background: "#03050c", borderRadius: 7, padding: "10px 14px", marginBottom: 12, fontFamily: mono, fontSize: 11 }}>
        <div style={{ color: "#334" }}>{"// What does this print? And in what order?"}</div>
        {[
          { t: "console.log('1 — sync');",                                        c: T.blue },
          { t: "setTimeout(() => console.log('4 — timeout'), 0);",               c: T.orange },
          { t: "Promise.resolve().then(() => console.log('3 — promise'));",       c: T.purple },
          { t: "console.log('2 — sync');",                                        c: T.blue },
        ].map((l, i) => <div key={i} style={{ color: l.c, padding: "1px 0" }}>{l.t}</div>)}
      </div>
      <div style={{ display: "flex", flexDirection: "column", gap: 4, marginBottom: 12 }}>
        {steps.map((s, i) => (
          <div key={i} style={{ display: "flex", gap: 10, padding: "7px 10px", background: step === i ? s.color + "15" : step > i ? s.color + "07" : "#03050c", border: `1px solid ${step >= i ? s.color + "40" : T.border}`, borderRadius: 6, transition: "all 0.35s" }}>
            <span style={{ fontSize: 14, width: 20, flexShrink: 0 }}>{step > i ? "✅" : step === i ? "⏳" : "○"}</span>
            <div style={{ flex: 1 }}>
              <div style={{ fontSize: 11, color: step >= i ? s.color : T.muted, fontFamily: mono, fontWeight: step === i ? 700 : 400 }}>{s.label}</div>
              {step === i && <div style={{ fontSize: 11, color: T.muted, fontFamily: serif, marginTop: 4, lineHeight: 1.6 }}>{s.desc}</div>}
            </div>
            <span style={{ fontSize: 9, padding: "2px 7px", background: (step >= i ? s.color : T.muted) + "18", borderRadius: 3, color: step >= i ? s.color : T.muted, fontFamily: mono, flexShrink: 0, alignSelf: "flex-start" }}>{s.phase}</span>
          </div>
        ))}
      </div>
      <div style={{ display: "flex", gap: 12, alignItems: "center", flexWrap: "wrap" }}>
        <button onClick={run} disabled={running}
          style={{ padding: "6px 16px", background: running ? T.muted + "18" : T.green + "22", border: `1px solid ${running ? T.border : T.green + "55"}`, color: running ? T.muted : T.green, borderRadius: 5, cursor: running ? "default" : "pointer", fontSize: 11, fontFamily: mono }}>
          {running ? "● running..." : "▶ Run it"}
        </button>
        <div style={{ display: "flex", gap: 6, alignItems: "center", flexWrap: "wrap" }}>
          <span style={{ fontSize: 10, color: T.muted, fontFamily: mono }}>console output:</span>
          {output.length === 0 ? <span style={{ fontSize: 10, color: "#1a2035", fontFamily: mono }}>press Run ▶</span>
            : output.map((o, i) => <span key={i} style={{ fontSize: 11, fontWeight: 700, color: o.color, fontFamily: mono, padding: "2px 8px", background: o.color + "18", borderRadius: 3 }}>{o.text}</span>)}
        </div>
      </div>
    </div>
  );
}

function StreamDemo() {
  const [mode, setMode] = useState("stream");
  const [chunks, setChunks] = useState([]);
  const [running, setRunning] = useState(false);
  const total = 8;
  const run = async () => {
    setRunning(true); setChunks([]);
    if (mode === "buffer") {
      for (let i = 0; i < total; i++) await new Promise(r => setTimeout(r, 120));
      setChunks(Array.from({ length: total }, (_, i) => i));
    } else {
      for (let i = 0; i < total; i++) { await new Promise(r => setTimeout(r, 300)); setChunks(p => [...p, i]); }
    }
    setRunning(false);
  };
  return (
    <div style={{ padding: 14, background: T.surface, border: `1px solid ${T.border}`, borderRadius: 10 }}>
      <div style={{ fontSize: 10, color: T.muted, fontFamily: mono, letterSpacing: 1, marginBottom: 10 }}>🧪 LIVE — compare: buffer (load all) vs stream (chunk by chunk)</div>
      <div style={{ display: "flex", gap: 6, marginBottom: 10 }}>
        {["stream", "buffer"].map(m => (
          <button key={m} onClick={() => { setMode(m); setChunks([]); }}
            style={{ padding: "4px 12px", background: mode === m ? T.teal + "22" : "transparent", border: `1px solid ${mode === m ? T.teal : T.border}`, color: mode === m ? T.teal : T.muted, borderRadius: 4, cursor: "pointer", fontSize: 11, fontFamily: mono }}>{m}</button>
        ))}
        <button onClick={run} disabled={running}
          style={{ padding: "4px 14px", background: running ? T.muted + "18" : T.green + "22", border: `1px solid ${running ? T.border : T.green + "55"}`, color: running ? T.muted : T.green, borderRadius: 4, cursor: running ? "default" : "pointer", fontSize: 11, fontFamily: mono }}>
          {running ? "● loading..." : "▶ Run"}
        </button>
      </div>
      <div style={{ fontSize: 11, color: T.muted, fontFamily: serif, marginBottom: 8 }}>
        {mode === "stream" ? "Each chunk appears as it arrives — you can start processing immediately ↓" : "Nothing appears until ALL chunks are loaded — then everything at once ↓"}
      </div>
      <div style={{ display: "flex", gap: 4, flexWrap: "wrap", minHeight: 44, marginBottom: 10 }}>
        {mode === "stream"
          ? chunks.map(c => <div key={c} style={{ width: 38, height: 38, background: T.teal + "22", border: `1px solid ${T.teal}55`, borderRadius: 5, display: "flex", alignItems: "center", justifyContent: "center", fontSize: 10, color: T.teal, fontFamily: mono }}>{c + 1}</div>)
          : running
            ? <div style={{ fontSize: 12, color: T.yellow, fontFamily: mono, padding: "8px 0" }}>⏳ loading all {total} chunks... you're stuck waiting</div>
            : chunks.map(c => <div key={c} style={{ width: 38, height: 38, background: T.orange + "22", border: `1px solid ${T.orange}55`, borderRadius: 5, display: "flex", alignItems: "center", justifyContent: "center", fontSize: 10, color: T.orange, fontFamily: mono }}>{c + 1}</div>)}
      </div>
      <div style={{ display: "flex", gap: 8, flexWrap: "wrap" }}>
        <div style={{ flex: 1, minWidth: 160, padding: "8px 10px", background: T.teal + "08", border: `1px solid ${T.teal}22`, borderRadius: 6 }}>
          <div style={{ fontSize: 10, color: T.teal, fontFamily: mono, marginBottom: 3 }}>✅ STREAM — always use for large data</div>
          <div style={{ fontSize: 11, color: T.muted, fontFamily: serif }}>64KB at a time. A 4GB file uses ~100KB RAM. Can start processing immediately.</div>
        </div>
        <div style={{ flex: 1, minWidth: 160, padding: "8px 10px", background: T.red + "08", border: `1px solid ${T.red}22`, borderRadius: 6 }}>
          <div style={{ fontSize: 10, color: T.red, fontFamily: mono, marginBottom: 3 }}>❌ BUFFER — dangerous for large files</div>
          <div style={{ fontSize: 11, color: T.muted, fontFamily: serif }}>Loads everything into RAM first. A 4GB file needs 4GB RAM — process crashes.</div>
        </div>
      </div>
    </div>
  );
}

